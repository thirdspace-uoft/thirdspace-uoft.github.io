rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Same access as before the blog: anyone signed in to /admin can edit.
    // The lab currently shares one admin account, so there is no per-person
    // list. Because any account counts, keep Email/Password sign-up disabled
    // in the Firebase console (Authentication → Settings → User actions);
    // otherwise anyone could create an account through the Auth API.
    function isAdmin() {
      return request.auth != null;
    }

    match /config/site {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /posts/{id} {
      // Drafts must not be readable by the public. The build uses the Admin
      // SDK, which bypasses these rules.
      allow read, write: if isAdmin();
    }

    match /private/{doc} {
      // Social tokens. Only the Admin SDK (GitHub Actions) touches these.
      allow read, write: if false;
    }
  }
}
